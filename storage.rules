rules_version = '2';

// House photos. Readable by any signed-in member (the delivery person relies on
// the photo to recognise the house); writable only by the owner, who sets the
// customer list up.
service firebase.storage {
  match /b/{bucket}/o {
    match /dairies/{dairyId}/customers/{customerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
